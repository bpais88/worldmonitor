# Seaosea — environment manifest
#
# Three deployables, three env sets. Copy to .env for local dev; set the rest in your host.
#   1. relay      (scripts/relay.cjs)      — Railway
#   2. assistant  (assistant/server.mjs)   — Railway, separate service
#   3. web + api  (index.html, api/*)      — Vercel
#
# Nothing here is shared with any other project. There is no upstream to coordinate with.

# ── 1. RELAY ────────────────────────────────────────────────────────────────────
PORT=3004

# REQUIRED. The relay refuses to boot without this (see assertAuthConfigured) —
# an absent secret must never silently publish the fleet. Any long random string.
RELAY_SHARED_SECRET=
# Header the secret travels in. Change it and every client must change with it.
RELAY_AUTH_HEADER=x-relay-key
# Deliberate public mode. Set to 1 ONLY if you intend an unauthenticated relay;
# it is the sole way to start without RELAY_SHARED_SECRET.
# ALLOW_UNAUTHENTICATED_RELAY=1

# Serve from a real database but never write to it. Set this when running a SECOND relay against
# a database another relay already owns — the cutover parity gate, or staging against prod data.
# Suppresses snapshots, geofence events, trips, baseline recompute and voyage counters; reads are
# unaffected. /health reports readOnly:true and the boot line says db=READ-ONLY.
# RELAY_READ_ONLY=1

# AIS ingest. Without AISSTREAM_API_KEY there is no live stream; without
# MARINESIA_API_KEY there is no fallback, and every port honestly reports
# coverageOk:false rather than a reassuring "clear".
AISSTREAM_API_KEY=
MARINESIA_API_KEY=
# >=12000 keeps the Marinesia sweep inside the 5 req/min Premium limit. The tile
# staleness threshold is DERIVED from this and the tile count — don't hardcode it.
MARINESIA_POLL_MS=13000

# Persistence. Postgres carries port snapshots, trips and congestion baselines;
# without it the relay still serves live data but every db-backed endpoint
# answers {found:false, db:false}. Run scripts/migrations/*.sql in order.
DATABASE_URL=
# Upstash holds the per-day voyage counters behind /ais/voyages/daily.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Tick cadences — defaults are sane; override only with a reason.
# FERRY_DELAY_INTERVAL_MS=60000
# GEOFENCE_TICK_MS=60000
# PORT_SNAPSHOT_MS=300000
# DISRUPTION_REFRESH_MS=10800000
# METEOALARM_REFRESH_MS=1800000
# PORT_CONTEXT_INTERVAL_MS=600000
# ENRICH_INTERVAL_MS=300000

# ── 2. ASSISTANT (Marco) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5

# Marco reads the relay over the same shared secret; point it at the relay's URL. In production
# this is UNCHANGED from the fork's relay — the domain moves with the service at cutover.
RELAY_URL=http://localhost:3004
# RELAY_SHARED_SECRET / RELAY_AUTH_HEADER — as above, same values.

# Channels. Each is optional: configure only the ones you actually run.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_BOT_USER_ID=
# Comma-separated user ids allowed to trigger ACTION-class tools.
SLACK_ACTION_USERS=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

MS_APP_ID=
MS_APP_SECRET=
MS_APP_TENANT_ID=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WA_CONTENT_SID=
WHATSAPP_WEBHOOK_SECRET=

ELEVENLABS_API_KEY=
VOICE_AGENT_ID=
VOICE_TOOL_SECRET=

# Scheduled ops report.
# OPS_REPORT_PLATFORM=slack
# OPS_REPORT_CHAT=
# OPS_REPORT_HOUR_UTC=7

# ── 3. WEB + API (Vercel) ───────────────────────────────────────────────────────
# The edge proxies in api/ forward to the relay using RELAY_URL + RELAY_SHARED_SECRET.
# API_VALID_KEYS gates public access to those proxies. REQUIRED where a route sets
# requireApiKey: an empty list returns 503 (deny) rather than waving traffic through
# a function that already holds the relay secret. Comma-separated.
API_VALID_KEYS=

# Public URL of the live freight board, printed in the corridor-report footer. The web app is a new
# Vercel project, so this is the one URL that changes. Unset -> the footer line is omitted rather
# than printing a stale link (the fork shipped its preview URL inside customer PDFs).
# BOARD_URL=

# ── E2E ─────────────────────────────────────────────────────────────────────────
# Point Playwright at a browser already on the machine (CI images pin their own
# revision). Unset for normal resolution.
# CHROMIUM_PATH=/opt/pw-browsers/chromium-1194/chrome-linux/chrome
