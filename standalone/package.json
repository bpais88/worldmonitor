{
  "name": "seaosea",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "European maritime freight monitoring \u2014 live AIS port congestion, vessel delays, disruptions, and the Marco assistant.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:relay": "node --test scripts/*.test.cjs",
    "test:assistant": "node --test assistant/*.test.mjs assistant/*/*.test.mjs",
    "test": "npm run test:relay && npm run test:assistant && npm run test:api",
    "assistant:cli": "node assistant/cli.mjs",
    "assistant:serve": "node assistant/server.mjs",
    "test:api": "node --test api/*.test.mjs",
    "test:e2e": "playwright test",
    "parity": "node scripts/parity-diff.cjs",
    "drift:voice": "node assistant/voice/drift-check.mjs",
    "eval:assistant": "node assistant/eval/tool-grounding.mjs",
    "report:corridor": "node --env-file-if-exists=.env scripts/corridor-report.cjs",
    "sar:sweep": "node scripts/sar-occupancy.cjs --days 45 --append scripts/data/sar-occupancy-log.jsonl",
    "relay": "node scripts/relay.cjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.36.1",
    "jose": "^6.2.8",
    "maplibre-gl": "^5.16.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
